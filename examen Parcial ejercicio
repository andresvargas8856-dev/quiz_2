print("\nPares con películas en común:")

nombres = list(usuarios.keys())  # solo para evitar repetir pares

for i in range(len(nombres)):
    for j in range(i + 1, len(nombres)):
        
        u1 = nombres[i]
        u2 = nombres[j]

        comunes = usuarios[u1].interseccion(usuarios[u2])

        # Si NO está vacío → tienen algo en común
        if not comunes.esta_vacio():
            print(f"{u1} - {u2}: ", end="")
            comunes.mostrar()

# 🔥 CLAVE:
# j empieza en i+1 para no repetir pares


# ============================================================
