mejor_usuario = None
max_peliculas = -1

# Recorremos con .items() porque necesitamos nombre + conjunto
for usuario, peliculas in usuarios.items():
    
    cantidad = peliculas.cardinalidad()

    if cantidad > max_peliculas:
        max_peliculas = cantidad
        mejor_usuario = usuario

print("\nUsuario con más películas:")
