# ============================================================
# PUNTO 6: CONTEO (PELÍCULA MÁS VISTA)
# ============================================================

conteo = {}  # diccionario para contar

# Recorremos todos los usuarios
for peliculas in usuarios.values():
    
    # Recorremos cada conjunto (usa __iter__ de tu clase)
    for peli in peliculas:
        
        # Contamos cuántas veces aparece cada película
        conteo[peli] = conteo.get(peli, 0) + 1


# Buscar la película con mayor conteo
max_peli = None
max_count = -1

for peli, cantidad in conteo.items():
    if cantidad > max_count:
        max_count = cantidad
        max_peli = peli

print("\nPelícula más vista:")
print(max_peli, "→", max_count)

